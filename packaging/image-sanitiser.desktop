[Desktop Entry]
Type=Application
Name=Image Sanitiser
Comment=Find QR codes and sensitive content in photos, redact them, verify they're gone
Exec=image-sanitiser %f
Icon=image-sanitiser
Categories=Graphics;2DGraphics;RasterGraphics;
Terminal=false
StartupNotify=true
MimeType=image/png;image/jpeg;image/webp;image/tiff;image/bmp;
